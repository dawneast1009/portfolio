<div class="file-row"><span class="file-type"><%= h(file['extension'].upcase) %></span><div class="file-info"><strong><%= h(file['label']) %></strong><span><%= h(file['filename']) %><% if file['demo'] %><span class="inline-sample">샘플</span><% end %></span></div><span class="file-size mono"><%= human_size(file['size']) %></span><span class="file-date"><%= date(file['created_at']) %></span><a class="download-link" href="/files/<%= h(file['id']) %>/download" aria-label="<%= h(file['label']) %> 다운로드"><%= icon('download') %><span>다운로드</span></a></div>
