<a class="back-link" href="<%= page_href(@page_key) %>#<%= entry_section(@record) %>"><%= icon('back') %><%= h(Notebook::PAGES[@page_key][:sections][entry_section(@record)]) %></a>
<header class="page-heading entry-heading"><div class="page-symbol"><%= icon('file') %></div><div class="heading-row"><h1><%= h(@record['title']) %></h1><% if editable? %><a class="button" href="/admin/notebook/<%= @record['id'] %>/edit"><%= icon('edit') %>편집</a><% end %></div><div class="entry-meta"><span><%= h(date(@record['updated_at'])) %> 수정</span><% if @record['demo'] %><span class="tag example">화면 확인용 예시</span><% end %><span class="tag"><%= @record['status'] == 'published' ? '공개 기록' : '비공개 기록' %></span><% unless @record['level'].to_s.empty? %><span class="tag level"><%= h(Notebook::LEVELS[@record['level']]) %> · 자기평가</span><% end %></div></header>
<div class="prose entry-body"><%= paragraphs(@record['body']) %></div>
<% unless @record['live_url'].to_s.empty? %><section class="document-section"><h2>관련 링크</h2><a class="record-link" href="<%= h(@record['live_url']) %>" target="_blank" rel="noopener noreferrer"><%= icon('external') %><%= h(@record['live_url']) %></a></section><% end %>
<% unless @record['repo_url'].to_s.empty? || @record['repo_url'] == @record['live_url'] %><a class="record-link" href="<%= h(@record['repo_url']) %>" target="_blank" rel="noopener noreferrer"><%= icon('code') %>소스 저장소</a><% end %>
<% files = attached_files(@record) %>
<section class="document-section"><div class="section-heading"><h2>첨부파일<span class="section-count"><%= files.size %></span></h2></div><% if files.empty? %><p class="empty-note">첨부된 파일이 없습니다</p><% end %>
<% files.each do |file| %><%= partial('notebook/attachment',file:file) %><% if Uploads::IMAGE_MIMES.include?(file['mime']) %><img class="attachment-image" loading="lazy" src="<%= attachment_href(file,preview:true) %>" alt="<%= h(file['label']) %>"><% end %><% end %></section>
