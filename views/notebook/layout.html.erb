<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="<%= h(@profile['intro']) %>">
  <title><%= h(@title) %> · <%= h(@profile['display_name']) %> 포트폴리오</title>
  <link rel="icon" href="<%= asset_href('favicon.svg') %>">
  <link rel="stylesheet" href="<%= asset_href('notebook.css') %>">
  <script src="<%= asset_href('app.js') %>" defer></script>
</head>
<body>
<a class="skip-link" href="#main">본문으로 이동</a>
<button class="menu-backdrop" type="button" aria-label="메뉴 닫기" tabindex="-1" hidden></button>
<aside class="sidebar" id="sidebar">
  <a class="workspace" href="<%= page_href('home') %>"><span class="workspace-icon"><%= icon('file') %></span><span><strong><%= h(@profile['display_name']) %></strong><small>나의 포트폴리오</small></span></a>
  <div class="sidebar-label">페이지</div>
  <nav aria-label="포트폴리오 메뉴">
    <% notebook_pages.each_with_index do |page,index| %>
    <a class="side-link <%= current_page == page['id'] ? 'is-current' : '' %>" href="<%= page_href(page['id']) %>" <%= current_page == page['id'] ? 'aria-current="page"' : '' %>><%= icon(page['icon']) %><span><%= h(page['title']) %></span><small><%= index+1 %></small></a>
    <% end %>
  </nav>
  <div class="sidebar-bottom">
    <% if editable? %>
    <a class="side-link" href="/admin/navigation"><%= icon('grid') %><span>목차 편집</span></a>
    <a class="side-link" href="/admin/profile"><%= icon('user') %><span>기본 정보 수정</span></a>
    <a class="side-link" href="/admin/share"><%= icon('external') %><span>공유 및 제출</span></a>
    <a class="side-link" href="/admin/security"><%= icon('lock') %><span>비밀번호 변경</span></a>
    <form action="/admin/logout" method="post"><%= csrf_field %><button class="side-link" type="submit"><%= icon('logout') %><span>로그아웃</span></button></form>
    <% elsif !@static %>
    <a class="side-link" href="/admin/login"><%= icon('lock') %><span>작성자 로그인</span></a>
    <% else %><p class="sidebar-footnote">공개된 기록을 모은 제출본</p><% end %>
  </div>
</aside>
<div class="workspace-main">
  <header class="topbar">
    <div class="breadcrumb"><button class="menu-toggle icon-button" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="목차 열기"><%= icon('menu') %></button><span>포트폴리오</span><span class="crumb-slash">/</span><strong><%= h(current_title) %></strong></div>
    <div class="top-actions"><% if editable? %><span class="editing-label">편집 가능</span><% end %><button type="button" class="button quiet" data-copy-page><%= icon('external') %><span>링크 복사</span></button></div>
  </header>
  <main id="main" tabindex="-1">
    <% if @flash %><div class="notice success" role="status"><%= h(@flash) %></div><% end %>
    <% if free_preview? && editable? %><div class="notice warning"><strong>무료 미리보기</strong> 재시작하면 작성 내용과 파일이 사라집니다. 원본은 컴퓨터에 보관하고 제출 전 <a href="/admin/share">제출본을 내보내세요</a>.</div><% end %>
    <%= @content %>
  </main>
  <footer class="page-footer"><span><%= h(@profile['display_name']) %> · 포트폴리오</span><span>배움과 활동의 기록</span></footer>
</div>
<div class="toast" role="status" aria-live="polite" hidden></div>
<dialog id="copy-dialog" aria-labelledby="copy-title"><h2 id="copy-title">페이지 링크</h2><p class="muted">자동 복사가 지원되지 않아 주소를 표시합니다</p><label for="copy-value">복사할 주소</label><input id="copy-value" readonly><form method="dialog"><button class="button" type="submit">닫기</button></form></dialog>
</body>
</html>
