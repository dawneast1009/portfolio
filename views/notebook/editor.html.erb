<a class="back-link" href="<%= page_href(@page_key) %>"><%= icon('back') %><%= h(Notebook::PAGES[@page_key][:title]) %></a>
<header class="page-heading editor-heading"><div class="heading-row"><h1><%= @record ? '기록 편집' : '새 기록' %></h1><% if @record %><a class="button quiet" href="<%= entry_href(@record) %>"><%= icon('eye') %>기록 보기</a><% end %></div><p class="page-description">글을 적고 저장한 다음 파일을 붙이세요. 자동 저장은 되지 않습니다.</p></header>
<% if @error %><div class="notice error" role="alert"><%= h(@error) %></div><% end %>
<form id="entry-form" action="<%= @record ? "/admin/notebook/#{@record['id']}" : '/admin/notebook' %>" method="post" data-unsaved-form>
<%= csrf_field %><input type="hidden" name="page" value="<%= h(@page_key) %>">
<div class="form-row"><div class="field"><label for="entry-section">항목</label><select id="entry-section" name="section"><% Notebook::PAGES[@page_key][:sections].each do |key,label| %><option value="<%= key %>" <%= selected(@values['section'],key) %>><%= h(label) %></option><% end %></select></div><div class="field"><label for="entry-status">공개 설정</label><select name="status" id="entry-status"><option value="draft" <%= selected(@values['status'],'draft') %>>비공개 · 나만 보기</option><option value="published" <%= selected(@values['status'],'published') %>>공개 · 링크로 방문한 사람에게 표시</option></select></div></div>
<div class="field"><label for="entry-title">제목 <span aria-hidden="true">*</span></label><input class="title-input" id="entry-title" name="title" required maxlength="100" value="<%= field('title') %>" placeholder="기록의 제목을 입력하세요"></div>
<div class="field"><label for="entry-body">내용</label><textarea id="entry-body" name="body" rows="12" maxlength="30000" placeholder="활동 내용, 맡은 역할, 배운 점을 자유롭게 적어 보세요"><%= field('body') %></textarea><p class="form-hint">줄바꿈이 그대로 보입니다. HTML은 실행되지 않으며 글자로 표시됩니다.</p></div>
<div class="form-row"><div class="field"><label for="entry-link">관련 링크 <span class="optional">선택</span></label><input type="url" id="entry-link" name="link" maxlength="1000" value="<%= field('link') %>" placeholder="https://..."></div><div class="field"><label for="entry-level">숙련도 <span class="optional">자기평가 · 선택</span></label><select name="level" id="entry-level"><% Notebook::LEVELS.each do |key,label| %><option value="<%= key %>" <%= selected(@values['level'],key) %>><%= h(label) %></option><% end %></select></div></div>
<div class="form-actions"><button class="button primary" type="submit"><%= icon('check') %>기록 저장</button><span class="form-hint" data-save-status>저장 버튼을 눌러 반영하세요</span></div>
</form>
<section id="attachments" class="document-section editor-attachments"><div class="section-heading"><h2>첨부파일</h2></div>
<% unless @record %><p class="empty-note">위에서 기록을 먼저 저장하면 파일을 첨부할 수 있습니다</p><% else %>
<% attached_files(@record).each do |file| %><div class="managed-attachment"><%= partial('notebook/attachment',file:file) %><div class="attachment-controls"><form action="/admin/notebook/<%= @record['id'] %>/files/<%= file['id'] %>/visibility" method="post"><%= csrf_field %><button class="button quiet small" type="submit"><%= file['public'] ? '비공개로 전환' : '공개로 전환' %></button></form><form action="/admin/notebook/<%= @record['id'] %>/files/<%= file['id'] %>/delete" method="post" data-confirm="이 첨부파일을 삭제할까요? 복구할 수 없습니다."><%= csrf_field %><button class="button quiet small danger" type="submit">삭제</button></form></div></div><% end %>
<form class="upload-form" action="/admin/notebook-upload" method="post" enctype="multipart/form-data"><%= csrf_field %><input type="hidden" name="project_id" value="<%= @record['id'] %>">
<div class="dropzone" data-dropzone><%= icon('upload') %><label for="notebook-file"><strong>파일을 끌어다 놓거나 선택하세요</strong></label><input type="file" id="notebook-file" name="file" accept="<%= Uploads::EXTENSIONS.join(',') %>" required data-file-input><span class="form-hint" data-file-label>파일 1개당 <%= human_size(@config.max_upload_bytes) %> 이하</span></div>
<div class="field"><label for="file-label">자료 이름 <span class="optional">선택</span></label><input id="file-label" name="label" maxlength="100" placeholder="비워 두면 파일 이름이 표시됩니다"></div>
<label class="check-label"><input type="checkbox" name="public" value="1">이 파일을 방문자에게 공개</label><p class="form-hint">기록과 파일이 모두 공개 상태여야 다른 사람이 볼 수 있습니다</p><button class="button" type="submit"><%= icon('plus') %>파일 첨부</button>
<p class="form-hint allowed-types">PDF · PNG/JPG/WEBP · HWP/HWPX · DOCX · PPTX · XLSX · TXT/MD · ZIP<br>문서는 다운로드로 제공하며 이미지 파일만 미리보기를 지원합니다</p>
</form><% end %></section>
<% if @record %><div class="delete-record"><form action="/admin/notebook/<%= @record['id'] %>/delete" method="post" data-confirm="기록과 연결된 모든 첨부파일을 삭제할까요? 복구할 수 없습니다."><%= csrf_field %><button class="button quiet danger" type="submit"><%= icon('trash') %>이 기록 삭제</button></form></div><% end %>
