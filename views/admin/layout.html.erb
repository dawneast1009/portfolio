<!DOCTYPE html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= h(@title) %> — Portfolio Studio</title><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/assets/site.css"><script src="/assets/app.js" defer></script></head><body class="admin-body"><a class="skip-link" href="#main">본문으로 이동</a><div class="admin-shell"><aside class="admin-sidebar"><a class="brand" href="/admin"><span class="brand-mark">d.</span><span>Portfolio<span class="studio-label">STUDIO</span></span></a><div class="sidebar-label">WORKSPACE</div><nav aria-label="관리 메뉴" class="admin-nav"><a class="<%= active('/admin') %>" href="/admin"><%= icon('grid') %>대시보드</a><a class="<%= active('/admin/projects') %>" href="/admin/projects"><%= icon('folder') %>프로젝트</a><a class="<%= active('/admin/files') %>" href="/admin/files"><%= icon('file') %>파일 관리</a><a class="<%= active('/admin/inbox') %>" href="/admin/inbox"><%= icon('mail') %>문의함<% if nav_count > 0 %><span class="nav-badge"><%= nav_count %></span><% end %></a><div class="sidebar-label">SETTINGS</div><a class="<%= active('/admin/profile') %>" href="/admin/profile"><%= icon('user') %>프로필</a><a class="<%= active('/admin/security') %>" href="/admin/security"><%= icon('lock') %>계정 보안</a></nav><div class="sidebar-bottom"><div class="sidebar-user"><span class="user-avatar"><%= h(@profile['display_name'][0].upcase) %></span><div><strong><%= h(@profile['display_name']) %></strong><span>사이트 관리자</span></div></div><form method="post" action="/admin/logout"><%= csrf_field %><button type="submit" class="logout-button"><%= icon('logout') %>로그아웃</button></form></div></aside><div class="admin-main"><header class="admin-topbar"><span><span class="muted">Workspace</span><span class="breadcrumb-divider">/</span><%= h(@title) %></span><a class="text-link" href="/" target="_blank" rel="noopener">사이트 보기 <%= icon('external') %></a></header><main id="main" class="admin-content"><% if @flash %><div class="notice success" role="status"><%= icon('check') %><%= h(@flash) %></div><% end %><%= @content %></main><footer class="admin-footer"><span class="mono">PORTFOLIO STUDIO / RUBY + HTML</span><span><span class="status-dot"></span> 로컬 파일 저장소</span></footer></div></div></body></html>
