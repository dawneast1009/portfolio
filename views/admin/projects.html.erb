<div class="admin-page-head"><div><div class="eyebrow blue">PROJECTS</div><h1>프로젝트 관리</h1><p>작업의 과정과 결과를 정리하세요</p></div><a class="button primary" href="/admin/projects/new"><%= icon('plus') %>새 프로젝트</a></div><div class="admin-panel"><div class="panel-heading"><nav class="filter-tabs" aria-label="공개 상태"><a class="<%= @query['status'].to_s.empty? ? 'active' : '' %>" href="/admin/projects">전체</a><a class="<%= @query['status'] == 'published' ? 'active' : '' %>" href="/admin/projects?status=published">공개</a><a class="<%= @query['status'] == 'draft' ? 'active' : '' %>" href="/admin/projects?status=draft">비공개</a></nav><span class="muted"><%= @projects.size %>개</span></div><% if @projects.empty? %><div class="empty-state"><%= icon('folder') %><h2>아직 프로젝트가 없습니다</h2><a class="button primary" href="/admin/projects/new">첫 프로젝트 만들기 <%= icon('plus') %></a></div><% else %><div class="table-wrap"><table><thead><tr><th>프로젝트</th><th>상태</th><th>대표</th><th>최근 수정</th><th>작업</th></tr></thead><tbody><% @projects.each do |project| %><tr><td><a class="table-title" href="/admin/projects/<%= h(project['id']) %>/edit"><%= h(project['title']) %></a><span class="table-sub"><%= h(category(project['category'])) %><%= project['demo'] ? ' · 샘플' : '' %></span></td><td><span class="badge <%= project['status'] == 'published' ? 'published' : 'draft' %>"><%= project['status'] == 'published' ? '공개' : '비공개' %></span></td><td><%= project['featured'] ? '✓' : '—' %></td><td class="muted"><%= date(project['updated_at']) %></td><td><div class="table-actions"><a class="icon-button" href="/projects/<%= h(project['id']) %>" target="_blank" rel="noopener" aria-label="<%= h(project['title']) %> 미리보기"><%= icon('eye') %></a><a class="icon-button" href="/admin/projects/<%= h(project['id']) %>/edit" aria-label="<%= h(project['title']) %> 수정"><%= icon('edit') %></a><form action="/admin/projects/<%= h(project['id']) %>/delete" method="post" data-confirm="프로젝트와 연결된 모든 첨부파일을 삭제할까요? 되돌릴 수 없습니다."><%= csrf_field %><button class="icon-button danger" type="submit" aria-label="<%= h(project['title']) %> 삭제"><%= icon('trash') %></button></form></div></td></tr><% end %></tbody></table></div><% end %></div>
