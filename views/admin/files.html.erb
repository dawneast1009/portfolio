<div class="admin-page-head"><div><div class="eyebrow blue">FILE MANAGER</div><h1>파일 관리</h1><p>프로젝트 이미지와 문서를 한곳에서 관리하세요</p></div><span class="storage-label mono"><%= human_size(@files.sum { |f| f['size'] }) %> / <%= human_size(@config.max_storage_bytes) %></span></div><% if @error %><div class="notice error" role="alert"><%= h(@error) %></div><% end %>
<section class="admin-panel upload-panel"><form action="/admin/files" method="post" enctype="multipart/form-data" data-upload-form data-max-bytes="<%= @config.max_upload_bytes %>"><%= csrf_field %><div class="upload-grid"><div class="drop-zone" data-drop-zone><div class="upload-icon"><%= icon('upload') %></div><strong>파일을 끌어다 놓거나 선택하세요</strong><span>PDF · PNG · JPG · WEBP · TXT · MD · ZIP</span><span class="muted">파일당 최대 <%= human_size(@config.max_upload_bytes) %> · 한 번에 1개</span><label class="button secondary small" for="file-input">파일 선택</label><input id="file-input" class="file-input" type="file" name="file" required accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.md,.zip"><div class="file-selection" data-file-selection aria-live="polite">선택한 파일이 없습니다</div></div><div class="upload-fields"><div class="field"><label for="file-label">자료 이름</label><input id="file-label" name="label" maxlength="100" placeholder="비워 두면 원래 파일 이름을 사용합니다" value="<%= field('label') %>"></div><div class="field"><label for="project-id">연결할 프로젝트</label><select id="project-id" name="project_id"><option value="">공통 자료 · 이력서</option><% @projects.each do |project| %><option value="<%= h(project['id']) %>" <%= selected(@values['project_id'], project['id']) %>><%= h(project['title']) %><%= project['status'] == 'draft' ? ' (비공개)' : '' %></option><% end %></select></div><label class="checkbox-label"><input type="checkbox" name="public" value="1" <%= checked(@values['public']) %>><span>방문자에게 공개</span></label><p class="form-hint">비공개 프로젝트에 연결하면 이 설정과 관계없이 방문자에게 숨겨집니다</p><button class="button primary" type="submit" data-upload-submit><%= icon('upload') %>업로드하기</button></div></div></form></section>
<section class="admin-panel"><div class="panel-heading"><h2>전체 파일 <span class="count"><%= @files.size %></span></h2><span class="muted">원본 이름과 별도로 저장됩니다</span></div><% if @files.empty? %><div class="empty-state compact"><%= icon('file') %><h3>업로드한 파일이 없습니다</h3><p>위에서 첫 파일을 추가해 보세요</p></div><% else %><div class="table-wrap"><table class="files-table"><thead><tr><th>자료</th><th>연결 프로젝트</th><th>공개 여부</th><th>크기</th><th>작업</th></tr></thead><tbody><% @files.each do |file| %><tr><td><div class="table-file"><span class="file-type small-type"><%= h(file['extension'].upcase) %></span><div><a class="table-title" href="/files/<%= h(file['id']) %>/download"><%= h(file['label']) %></a><span class="table-sub"><%= h(file['filename']) %><%= file['demo'] ? ' · 샘플' : '' %></span></div></div></td><td class="muted"><%= h(file['project_id'] ? @repo.project(file['project_id'])&.fetch('title', '—') : '공통 자료') %></td><td><span class="badge <%= @repo.public_file?(file) ? 'published' : 'draft' %>"><%= @repo.public_file?(file) ? '공개' : '비공개' %></span></td><td class="nowrap muted"><%= human_size(file['size']) %></td><td><div class="table-actions"><a class="icon-button" href="/files/<%= h(file['id']) %>/download" aria-label="<%= h(file['label']) %> 다운로드"><%= icon('download') %></a><% if file['project_id'] && Uploads::IMAGE_MIMES.include?(file['mime']) %><form action="/admin/files/<%= h(file['id']) %>/cover" method="post"><%= csrf_field %><button class="icon-button" type="submit" aria-label="<%= h(file['label']) %> 대표 이미지로 설정" title="대표 이미지로 설정"><%= icon('grid') %></button></form><% end %><form action="/admin/files/<%= h(file['id']) %>/visibility" method="post"><%= csrf_field %><button class="icon-button" type="submit" aria-label="<%= h(file['label']) %> <%= file['public'] ? '비공개로 변경' : '공개로 변경' %>" title="<%= file['public'] ? '비공개로 변경' : '공개로 변경' %>"><%= icon(file['public'] ? 'eye' : 'lock') %></button></form><form action="/admin/files/<%= h(file['id']) %>/delete" method="post" data-confirm="이 파일을 영구적으로 삭제할까요?"><%= csrf_field %><button class="icon-button danger" type="submit" aria-label="<%= h(file['label']) %> 삭제"><%= icon('trash') %></button></form></div></td></tr><% end %></tbody></table></div><% end %></section>
