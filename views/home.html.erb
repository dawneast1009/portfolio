<div class="container">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span> <%= h(@profile['role']) %></div>
      <h1 id="hero-title"><%= h(@profile['headline']).gsub("\n", '<br>') %><span class="blue-dot">.</span></h1>
      <p class="hero-description"><%= h(@profile['intro']) %></p>
      <div class="hero-actions"><a class="button primary" href="/projects">프로젝트 둘러보기 <%= icon('arrow') %></a><a class="text-link" href="/about">조금 더 알아보기 <%= icon('external') %></a></div>
    </div>
    <aside class="hero-index" aria-label="사이트 목차">
      <div class="index-top"><span class="mono">IN THIS SPACE</span><span class="mono"><%= Time.now.year %> —</span></div>
      <a href="/projects"><span class="index-number">01</span><span>만든 프로젝트</span><span class="index-count"><%= format('%02d', @project_count) %></span><%= icon('external') %></a>
      <a href="/files"><span class="index-number">02</span><span>공유하는 자료</span><span class="index-count"><%= format('%02d', @file_count) %></span><%= icon('external') %></a>
      <a href="/about"><span class="index-number">03</span><span>나에 대한 기록</span><span class="index-count">—</span><%= icon('external') %></a>
      <div class="index-bottom"><span class="small-square"></span><%= h(@profile['status']) %></div>
    </aside>
  </section>
  <section class="section work-section" aria-labelledby="work-title">
    <div class="section-head"><div><div class="eyebrow blue">01 / SELECTED WORK</div><h2 id="work-title">프로젝트</h2></div><a class="text-link" href="/projects">전체 프로젝트 <%= icon('arrow') %></a></div>
    <% if @projects.empty? %><div class="empty-state"><%= icon('folder') %><h3>첫 프로젝트를 기다리고 있어요</h3><p>새로운 작업이 등록되면 이곳에서 볼 수 있습니다</p></div><% else %>
    <div class="project-grid"><% @projects.first(2).each_with_index do |project, index| %><%= partial('project_card', project: project, index: index) %><% end %></div>
    <% @projects.drop(2).each do |project| %><a class="archive-project" href="/projects/<%= h(project['id']) %>"><span class="mono">MORE WORK</span><strong><%= h(project['title']) %></strong><span class="archive-summary"><%= h(project['summary']) %></span><%= icon('arrow') %></a><% end %>
    <% end %>
  </section>
  <section class="section file-section" aria-labelledby="files-title">
    <div class="section-head"><div><div class="eyebrow blue">02 / RESOURCES</div><h2 id="files-title">함께 보는 자료</h2></div><a class="text-link" href="/files">자료실 열기 <%= icon('arrow') %></a></div>
    <% if @files.empty? %><div class="empty-state compact"><p>공개된 자료가 아직 없습니다</p></div><% else %><div class="file-list"><% @files.each do |file| %><%= partial('file_row', file: file) %><% end %></div><% end %>
  </section>
  <section class="contact-strip"><div><div class="eyebrow">LET’S TALK</div><h2>함께 나눌 이야기가 있나요?</h2><p>프로젝트에 대한 질문이나 새로운 아이디어를 남겨 주세요</p></div><a class="button primary" href="/contact">메시지 남기기 <%= icon('external') %></a></section>
</div>
