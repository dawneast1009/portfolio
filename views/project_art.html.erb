<% if project['category'] == 'security' %>
<div class="terminal-art" aria-hidden="true"><div class="terminal-bar"><span class="terminal-dots"><i></i><i></i><i></i></span><span>workspace / projects</span></div><div class="terminal-content"><div class="terminal-command"><span>~/</span> <%= h(project['title'].downcase.tr(' ', '-')) %></div><div class="terminal-line"><span class="terminal-muted">01</span><span class="terminal-accent">project</span> <%= h(project['title']) %></div><div class="terminal-line"><span class="terminal-muted">02</span><span class="terminal-accent">stack</span> <%= h(project['tags'].first(3).join(' · ')) %></div><div class="terminal-line"><span class="terminal-muted">03</span><span class="terminal-accent">notes</span> ideas → code → learn</div><div class="terminal-prompt">❯ <span class="terminal-cursor"></span></div></div><div class="art-corner">EXPLORE THE PROCESS <span>↗</span></div></div>
<% elsif project['category'] == 'research' %>
<div class="notes-art" aria-hidden="true"><div class="notes-page"><div class="notes-top">FIELD NOTES<span>№ 02</span></div><strong>Learn.<br>Test.<br><span>Document.</span></strong><div class="notes-rule"></div><div class="notes-caption"><%= h(project['title']) %> / <%= h(project['year']) %></div></div><div class="notes-margin">THINKING IN PROGRESS</div></div>
<% else %>
<div class="browser-art" aria-hidden="true"><div class="browser-window"><div class="browser-top"><span>◦ ◦ ◦</span><span>localhost / portfolio</span></div><div class="browser-content"><div class="mini-label">PERSONAL WORKSPACE</div><strong>Build something<br>worth sharing<span>.</span></strong><div class="mini-rule"></div><div class="mini-grid"><div></div><div></div><div></div></div></div></div></div>
<% end %>
