<div class="container page-section">
  <a class="back-link" href="/projects"><%= icon('back') %> 프로젝트 목록</a>
  <% if @project['status'] == 'draft' %><div class="notice"><%= icon('lock') %>비공개 프로젝트 미리보기 · 관리자에게만 표시됩니다</div><% end %>
  <% if @project['demo'] %><div class="sample-notice">샘플 프로젝트입니다 · 화면 구성을 확인하기 위한 예시이며 실제 활동을 증명하는 내용이 아닙니다</div><% end %>
  <div class="detail-heading"><div class="eyebrow blue"><%= h(category(@project['category'])) %> / <%= h(@project['year']) %></div><h1><%= h(@project['title']) %></h1><p><%= h(@project['summary']) %></p><div class="tags"><% @project['tags'].each do |tag| %><a href="/projects?tag=<%= q(tag) %>"><%= h(tag) %></a><% end %></div></div>
  <div class="detail-grid"><article><div class="project-cover detail-cover cover-<%= h(@project['category']) %>"><% if (cover = cover_file(@project)) %><img src="/files/<%= h(cover['id']) %>/preview" alt="<%= h(@project['title']) %> 대표 이미지"><% else %><%= partial('project_art', project: @project) %><% end %></div><div class="prose project-prose"><h2>프로젝트 기록</h2><%= paragraphs(@project['body'].empty? ? '프로젝트에 대한 자세한 기록을 준비하고 있습니다' : @project['body']) %></div>
  <% unless @files.empty? %><section class="detail-files"><h2>첨부 자료 <span class="count"><%= @files.size %></span></h2><div class="file-list"><% @files.each do |file| %><%= partial('file_row', file: file) %><% end %></div></section><% end %></article>
  <aside class="detail-aside"><div class="eyebrow">PROJECT INFORMATION</div><dl><div><dt>분야</dt><dd><%= h(category(@project['category'])) %></dd></div><div><dt>연도</dt><dd><%= h(@project['year']) %></dd></div><div><dt>최근 수정</dt><dd><%= date(@project['updated_at']) %></dd></div><div><dt>첨부 자료</dt><dd><%= @files.size %>개</dd></div></dl><% unless @project['repo_url'].empty? %><a class="button secondary full-width" href="<%= h(@project['repo_url']) %>" target="_blank" rel="noopener noreferrer">소스 코드 <%= icon('external') %></a><% end %><% unless @project['live_url'].empty? %><a class="button primary full-width" href="<%= h(@project['live_url']) %>" target="_blank" rel="noopener noreferrer">사이트 방문 <%= icon('external') %></a><% end %><% if @admin %><a class="text-link" href="/admin/projects/<%= h(@project['id']) %>/edit"><%= icon('edit') %> 프로젝트 수정</a><% end %></aside></div>
</div>
