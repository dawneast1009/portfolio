<div class="container page-section">
  <div class="page-heading"><div class="eyebrow blue">WORK ARCHIVE</div><h1>프로젝트<span class="blue-dot">.</span></h1><p>직접 만든 것들과 그 안에서 배운 과정을 모았습니다</p></div>
  <div class="filter-bar"><nav class="filter-tabs" aria-label="프로젝트 카테고리"><a class="<%= @query.fetch('category', '').empty? ? 'active' : '' %>" href="/projects<%= @query['q'].to_s.empty? ? '' : '?q=' + q(@query['q']) %>">전체</a><% Repository::CATEGORIES.each do |value, label| %><a class="<%= @query['category'] == value ? 'active' : '' %>" href="/projects?category=<%= q(value) %><%= @query['q'].to_s.empty? ? '' : '&amp;q=' + q(@query['q']) %>"><%= h(label) %></a><% end %></nav><form action="/projects" method="get" class="search-form"><%= icon('search') %><label class="sr-only" for="project-search">프로젝트 검색</label><input id="project-search" name="q" placeholder="프로젝트 검색" value="<%= h(@query['q']) %>" maxlength="120"><% unless @query['category'].to_s.empty? %><input type="hidden" name="category" value="<%= h(@query['category']) %>"><% end %><button type="submit" class="search-submit" aria-label="검색하기"><%= icon('arrow') %></button></form></div>
  <div class="result-line"><span><strong><%= @projects.size %></strong>개의 프로젝트<% unless @query['tag'].to_s.empty? %> · 태그 <strong><%= h(@query['tag']) %></strong><% end %></span><% if @query.values.any? { |v| !v.to_s.empty? } %><a href="/projects">필터 초기화 <%= icon('close') %></a><% else %><span class="mono">BUILD / EXPLORE / DOCUMENT</span><% end %></div>
  <% if @projects.empty? %><div class="empty-state"><%= icon('search') %><h2>일치하는 프로젝트가 없습니다</h2><p>다른 검색어나 카테고리로 찾아보세요</p><a class="button secondary" href="/projects">전체 프로젝트 보기</a></div><% else %><div class="project-grid archive-grid"><% @projects.each_with_index do |project, index| %><%= partial('project_card', project: project, index: index) %><% end %></div><% end %>
  <% unless @tags.empty? %><div class="all-tags"><span class="eyebrow">EXPLORE BY TAG</span><div class="tags"><% @tags.each do |tag| %><a href="/projects?tag=<%= q(tag) %>"><%= h(tag) %></a><% end %></div></div><% end %>
</div>
