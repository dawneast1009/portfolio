# Copy to .env only when overriding the defaults. Never commit the actual .env.
APP_ENV=development
BIND=127.0.0.1
PORT=4567
APP_URL=http://localhost:4567
STORAGE_DIR=storage
MAX_UPLOAD_MB=10
MAX_STORAGE_MB=500
# Optional durable storage for Render: set all three values together.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=keep-this-server-secret
# SUPABASE_BUCKET=portfolio-data
# Production: use Puma (not app.rb), APP_ENV=production and an HTTPS APP_URL.
# See docs/deployment.md for TLS, storage, single-process and rate-limit requirements.
# Passwords are created by ruby bin/setup, not stored in .env.
