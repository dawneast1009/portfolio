<div class="container error-page"><div class="eyebrow blue">REQUEST INFORMATION</div><div class="error-code"><%= @error_code %><span class="blue-dot">.</span></div><h1><%= @error_code == 404 ? '찾을 수 없는 페이지입니다' : '요청을 확인해 주세요' %></h1><p><%= h(@error_message) %></p><a class="button primary" href="<%= @admin ? '/admin' : '/' %>"><%= icon('back') %> <%= @admin ? '관리 화면으로' : '홈으로 돌아가기' %></a></div>
