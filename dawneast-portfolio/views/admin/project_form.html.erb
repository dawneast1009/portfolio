<div class="admin-page-head"><div><a class="back-link" href="/admin/projects"><%= icon('back') %> 프로젝트 목록</a><h1><%= @values['id'] ? '프로젝트 수정' : '새 프로젝트' %></h1><p>완성되지 않은 작업은 비공개로 저장해 둘 수 있어요</p></div><% if @values['id'] %><a class="button secondary" href="/projects/<%= field('id') %>" target="_blank" rel="noopener"><%= icon('eye') %>미리보기</a><% end %></div><% if @error %><div class="notice error" role="alert"><%= h(@error) %></div><% end %>
<form action="<%= @values['id'] ? '/admin/projects/' + h(@values['id']) : '/admin/projects' %>" method="post"><%= csrf_field %><div class="editor-grid"><div class="admin-panel form-panel"><h2>기본 정보</h2><div class="field"><label for="title">프로젝트 이름 <span>*</span></label><input id="title" name="title" required maxlength="100" placeholder="어떤 프로젝트인가요?" value="<%= field('title') %>"></div><div class="field"><label for="summary">한 줄 소개 <span>*</span></label><textarea id="summary" name="summary" rows="3" required maxlength="280" placeholder="어떤 문제를 해결하는 프로젝트인지 짧게 설명해 주세요"><%= field('summary') %></textarea></div><div class="field"><label for="body">프로젝트 기록</label><textarea class="body-editor" id="body" name="body" rows="14" maxlength="30000" placeholder="프로젝트 개요, 내가 맡은 역할, 구현 과정, 배운 점을 적어 주세요"><%= field('body') %></textarea><p class="form-hint">줄바꿈이 그대로 반영됩니다. HTML 코드는 실행되지 않고 문자로 표시됩니다.</p></div><div class="field"><label for="tags">기술 태그</label><input id="tags" name="tags" maxlength="300" value="<%= h(@values['tags'].is_a?(Array) ? @values['tags'].join(', ') : @values['tags']) %>" placeholder="Ruby, HTML, CSS"><p class="form-hint">쉼표로 구분 · 최대 8개 · 태그당 24자</p></div><div class="form-row"><div class="field"><label for="repo-url">소스 코드 주소</label><input id="repo-url" name="repo_url" type="url" maxlength="1000" value="<%= field('repo_url') %>" placeholder="https://github.com/..."></div><div class="field"><label for="live-url">사이트 주소</label><input id="live-url" name="live_url" type="url" maxlength="1000" value="<%= field('live_url') %>" placeholder="https://..."></div></div></div><aside><div class="admin-panel form-panel"><h2>공개 설정</h2><div class="field"><label for="status">공개 상태</label><select id="status" name="status"><option value="draft" <%= selected(@values['status'], 'draft') %>>비공개 · 나만 보기</option><option value="published" <%= selected(@values['status'], 'published') %>>공개 · 포트폴리오에 표시</option></select></div><div class="field"><label for="category">카테고리</label><select id="category" name="category"><% Repository::CATEGORIES.each do |value, label| %><option value="<%= h(value) %>" <%= selected(@values['category'], value) %>><%= h(label) %></option><% end %></select></div><div class="field"><label for="year">작업 연도</label><input id="year" name="year" required pattern="[0-9]{4}" inputmode="numeric" maxlength="4" value="<%= field('year') %>"></div><label class="checkbox-label"><input type="checkbox" name="featured" value="1" <%= checked(@values['featured']) %>><span>대표 프로젝트로 설정</span></label><p class="form-hint">공개 상태일 때 홈 화면에 우선 표시됩니다</p><button class="button primary full-width" type="submit"><%= icon('check') %>프로젝트 저장</button></div><div class="admin-panel form-panel"><h2>대표 이미지와 자료</h2><% if @values['id'] %><div class="field"><label for="cover-id">대표 이미지</label><select id="cover-id" name="cover_id"><option value="">기본 프로젝트 화면</option><% @images.each do |image| %><option value="<%= h(image['id']) %>" <%= selected(@values['cover_id'], image['id']) %>><%= h(image['filename']) %><%= image['public'] ? '' : ' (비공개 이미지)' %></option><% end %></select></div><a class="button secondary full-width" href="/admin/files?project_id=<%= field('id') %>"><%= icon('upload') %>파일 업로드</a><p class="form-hint">공개 이미지로 설정해야 방문자에게도 대표 이미지가 보입니다</p><% else %><p class="muted">프로젝트를 먼저 저장한 뒤 대표 이미지와 첨부파일을 연결할 수 있어요</p><% end %></div></aside></div></form>
