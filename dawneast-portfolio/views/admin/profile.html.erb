<div class="admin-page-head"><div><div class="eyebrow blue">PROFILE & LINKS</div><h1>프로필 설정</h1><p>홈 화면과 소개 페이지에 표시되는 내용을 수정하세요</p></div><a class="button secondary" href="/about" target="_blank" rel="noopener">소개 페이지 보기 <%= icon('external') %></a></div><% if @error %><div class="notice error" role="alert"><%= h(@error) %></div><% end %><form action="/admin/profile" method="post"><%= csrf_field %><div class="editor-grid"><div><section class="admin-panel form-panel"><h2>기본 프로필</h2><div class="form-row"><div class="field"><label for="display-name">닉네임 <span>*</span></label><input id="display-name" name="display_name" required maxlength="40" value="<%= field('display_name') %>"></div><div class="field"><label for="location">활동 지역</label><input id="location" name="location" maxlength="80" value="<%= field('location') %>"></div></div><div class="field"><label for="role">관심 분야 · 상단 문구</label><input id="role" name="role" maxlength="100" value="<%= field('role') %>"></div><div class="field"><label for="headline">홈 화면 제목 <span>*</span></label><textarea id="headline" name="headline" rows="3" required maxlength="100"><%= field('headline') %></textarea><p class="form-hint">원하는 위치에서 줄바꿈할 수 있습니다</p></div><div class="field"><label for="intro">짧은 소개</label><textarea id="intro" name="intro" rows="4" maxlength="500"><%= field('intro') %></textarea></div><div class="field"><label for="bio">자세한 소개</label><textarea id="bio" name="bio" rows="9" maxlength="6000"><%= field('bio') %></textarea></div><div class="field"><label for="skills">도구와 관심 분야</label><input id="skills" name="skills" maxlength="300" value="<%= field('skills') %>"><p class="form-hint">쉼표로 구분해 주세요</p></div><div class="field"><label for="profile-status">목차 하단 문구</label><input id="profile-status" name="status" maxlength="80" value="<%= field('status') %>"></div></section></div><aside><section class="admin-panel form-panel"><h2>외부 링크</h2><div class="field"><label for="github-url">GitHub</label><input id="github-url" name="github_url" type="url" maxlength="1000" value="<%= field('github_url') %>" placeholder="https://github.com/..."></div><div class="field"><label for="blog-url">블로그</label><input id="blog-url" name="blog_url" type="url" maxlength="1000" value="<%= field('blog_url') %>" placeholder="https://velog.io/@..."></div><div class="field"><label for="profile-email">공개 연락 이메일</label><input id="profile-email" name="contact_email" type="email" maxlength="200" value="<%= field('contact_email') %>"><p class="form-hint">비워 두면 이메일 주소가 표시되지 않습니다</p></div></section><section class="admin-panel form-panel"><h2>이력서</h2><div class="field"><label for="resume-id">이력서 PDF</label><select id="resume-id" name="resume_id"><option value="">이력서 버튼 숨기기</option><% @pdfs.each do |file| %><option value="<%= h(file['id']) %>" <%= selected(@values['resume_id'], file['id']) %>><%= h(file['label']) %></option><% end %></select><p class="form-hint">파일 관리에서 공개 PDF를 먼저 업로드해 주세요</p></div><a class="text-link" href="/admin/files">파일 관리 <%= icon('arrow') %></a></section><button class="button primary full-width" type="submit"><%= icon('check') %>프로필 저장</button></aside></div></form>
