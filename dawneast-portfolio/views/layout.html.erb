<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= h(@profile['intro']) %>">
  <title><%= h(@title) %> — <%= h(@profile['display_name']) %></title>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/site.css">
  <script src="/assets/app.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">본문으로 이동</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="<%= h(@profile['display_name']) %> 홈"><span class="brand-mark">d.</span><span><%= h(@profile['display_name']) %><span class="brand-suffix"> / portfolio</span></span></a>
      <button class="nav-toggle icon-button" type="button" aria-label="메뉴 열기" aria-controls="site-nav" aria-expanded="false"><%= icon('menu') %></button>
      <nav id="site-nav" class="site-nav" aria-label="주 메뉴">
        <a class="<%= active('/projects') %>" href="/projects">프로젝트</a>
        <a class="<%= active('/about') %>" href="/about">소개</a>
        <a class="<%= active('/files') %>" href="/files">자료실</a>
        <a class="nav-contact <%= active('/contact') %>" href="/contact">연락하기 <%= icon('external') %></a>
      </nav>
    </div>
  </header>
  <main id="main" class="public-main">
    <% if @flash %><div class="container"><div class="notice success" role="status"><%= icon('check') %><%= h(@flash) %></div></div><% end %>
    <%= @content %>
  </main>
  <footer class="site-footer container">
    <div><a class="footer-name" href="/"><%= h(@profile['display_name']) %><span class="blue-dot">.</span></a><span class="footer-copy">© <%= Time.now.year %> · 직접 만들고 기록하는 공간</span></div>
    <div class="footer-right"><span class="mono">BUILT WITH RUBY + HTML</span><a href="/admin"><%= @admin ? '관리 화면' : '관리자' %> <%= icon('external') %></a></div>
  </footer>
</body>
</html>
