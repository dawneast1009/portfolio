#!/usr/bin/env python3
"""Optional real Chromium checks. Run against a local server containing disposable test data.
Requires Python playwright and a locally installed Chromium; not needed to run the Ruby app.
"""
import argparse, json, re, urllib.request
from pathlib import Path
from playwright.sync_api import sync_playwright

p = argparse.ArgumentParser()
p.add_argument('--url', default='http://127.0.0.1:4567')
p.add_argument('--output', default='/tmp/portfolio-browser-check')
p.add_argument('--chromium', default='/usr/bin/chromium')
p.add_argument('--offline-render',action='store_true',help='Fetch localhost HTML with Python and render it without browser networking')
a = p.parse_args()
out = Path(a.output); out.mkdir(parents=True, exist_ok=True)
report = []
with sync_playwright() as pw:
    browser = pw.chromium.launch(executable_path=a.chromium, headless=True, args=['--no-sandbox'])
    for width in (360,390,768,1440):
        page = browser.new_page(viewport={'width':width,'height':950},device_scale_factor=1)
        errors = []
        page.on('pageerror',lambda e: errors.append(str(e)))
        for route in ('/','/about','/career','/activities','/projects'):
            if a.offline_render:
                with urllib.request.urlopen(a.url.rstrip('/')+route) as response:
                    status = response.status
                    html = response.read().decode('utf-8')
                root = Path(__file__).resolve().parents[1]
                css = (root/'public/assets/notebook.css').read_text()
                js = (root/'public/assets/app.js').read_text()
                html = re.sub(r'<link rel="stylesheet"[^>]+>', lambda _: '<style>'+css+'</style>', html)
                html = re.sub(r'<script src="[^"]+" defer></script>', lambda _: '', html)
                page.set_content(html,wait_until='load')
                page.add_script_tag(content=js)
            else:
                response = page.goto(a.url.rstrip('/')+route,wait_until='networkidle')
                status = response.status
            assert status == 200, (route,status)
            assert page.locator('nav[aria-label="포트폴리오 메뉴"] > a').count()==5
            assert page.evaluate('document.documentElement.scrollWidth <= innerWidth'), (width,route,'overflow')
            report.append({'width':width,'route':route,'status':status,'mode':'offline-render' if a.offline_render else 'live-browser','horizontal_overflow':False})
            if (width in (390,1440)) and route in ('/','/projects','/about'):
                page.screenshot(path=str(out/f'{width}-{route.strip("/") or "home"}.png'),full_page=True)
        if width < 768:
            page.locator('.menu-toggle').click()
            assert page.locator('#sidebar').is_visible()
            page.keyboard.press('Escape')
            assert not page.locator('#sidebar').is_visible()
        assert not errors, errors
        page.close()
    browser.close()
(out/'report.json').write_text(json.dumps(report,ensure_ascii=False,indent=2))
print(f'{len(report)} public page/viewport checks passed')
